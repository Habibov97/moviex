# Copy to `.env` and fill in. Never commit the real `.env`.

# Postgres connection string (a remote Supabase instance in this project).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Port this API listens on. The web app is separate, on 3001.
PORT=3000

# Auth. JWT_SECRET must be a long random string.
JWT_SECRET=replace-with-a-long-random-string

# The two session lengths. JWT_EXPIRES_IN is the default; JWT_REMEMBER_EXPIRES_IN
# is used when the login form's "Remember me" is ticked. There are no refresh
# tokens in this app, so the signed lifetime is the whole session.
#
# Each also becomes the access_token cookie's maxAge for that login — the value
# is read back off the token's own claims rather than parsed twice, so the two
# cannot drift. Change a duration here and both move together.
#
# JWT_REMEMBER_EXPIRES_IN is optional and defaults to 30d if unset.
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Origins allowed to make credentialed (cookie-bearing) requests.
#
# Comma-separated, no spaces needed. These are the *frontend's* origins — the
# web app runs on 3001, not the API's 3000.
#
# Add the dev machine's LAN IP to test from a phone on the same network; both
# entries stay valid at once, so localhost keeps working. Find the IP with
# `ipconfig getifaddr en0` (macOS) or `hostname -I` (Linux).
FRONTEND_URLS=http://localhost:3001,http://192.168.1.10:3001

# In production only the FIRST entry is used, as a single strict origin.
# `FRONTEND_URL` (singular) is still read as a fallback for older configs.

# Whether a reverse proxy sits in front of this API. Leave UNSET locally.
#
# Rate limiting counts per `req.ip`, which Express reads off the socket unless
# told otherwise. Behind a load balancer or platform router without this, every
# request carries the proxy's address and the whole world shares one bucket.
# Setting it when nothing is actually rewriting X-Forwarded-For is the opposite
# mistake: a client can then forge an address per request and the limits stop
# meaning anything. Set it only where a proxy really is in front.
#
# `1` = one trusted hop (the common case). A comma-separated list of addresses
# or subnets also works, and is passed through to Express as-is.
# TRUST_PROXY=1
